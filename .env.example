# Online Study System sample — eval environment template.
#
# NOTE: `.env` itself is TRACKED in this repo on purpose (see .gitignore):
# its values are the upstream public seed (sql/online_study_system.sql —
# every seeded user's password is `123`, salted SHA-1 x1024), so every
# researcher gets an identical, deterministic environment.  NEVER put real
# secrets in a tracked .env — those belong in gitignored files only.
#
# These values reach the app through `compose.yaml` and the e2e flows; the
# flows read them from the environment — never hardcode them.
#
# Host ports are NOT configured here: `compose.yaml` publishes
# `${BENCH_HTTP_PORT:-8091}`, and the harness exports it before every
# `compose` call so runs never collide. The database publishes nothing —
# the harness reaches it with `docker compose exec db ...`.

# Seeded accounts the e2e flows log in with
# (role: 1=admin, 2=teacher, 3=student).
OSS_ADMIN_USER=admin
OSS_ADMIN_PASSWORD=123
OSS_STUDENT_USER=小明
OSS_STUDENT_PASSWORD=123
OSS_STUDENT2_USER=小红
OSS_STUDENT2_PASSWORD=123
OSS_TEACHER_USER=李老师
OSS_TEACHER_PASSWORD=123

# Host port used by `reset.sh` and manual runs. The harness allocates its
# own port and exports BENCH_HTTP_PORT, which wins over this.
OSS_HTTP_PORT=8091
